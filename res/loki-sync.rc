// Common controls v6 and DPI awareness for wxWidgets on Windows.
#define wxUSE_RC_MANIFEST 1
#define wxUSE_DPI_AWARE_MANIFEST 2
#include "wx/msw/wx.rc"

// Explorer and Task Manager show the application name, independently of the
// repository/build target name and the legacy settings directory.
1 VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "LOKI\0"
            VALUE "FileDescription", "LOKI Client\0"
            VALUE "FileVersion", "0.1.0.0\0"
            VALUE "InternalName", "loki-client\0"
            VALUE "OriginalFilename", "loki-client.exe\0"
            VALUE "ProductName", "LOKI Client\0"
            VALUE "ProductVersion", "0.1.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
